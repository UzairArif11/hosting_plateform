                {
                    "name": "Create Project",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const response = pm.response.json();",
                                    "    pm.collectionVariables.set('project_id', response.data._id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
