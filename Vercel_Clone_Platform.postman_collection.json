                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"my-awesome-project\",\n  \"repository\": {\n    \"url\": \"https://github.com/username/repo\",\n    \"owner\": \"username\",\n    \"name\": \"repo\",\n    \"branch\": \"main\"\n  },\n  \"framework\": \"nextjs\",\n  \"environmentVariables\": {\n    \"NODE_ENV\": \"production\",\n    \"API_URL\": \"https://api.example.com\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/projects",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "projects"
                            ]
                        }
                    },
                    "response": []
