# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=production
JWT_SECRET=change_this_secret_key_in_production_please
BASE_DOMAIN=foodpanda.site

# ============================================
# Database Configuration (Matches docker-compose.yml)
# ============================================
MONGO_URI=mongodb://admin:password123@localhost:27017/vercel_clone?authSource=admin
REDIS_PORT=6379

# ============================================
# SSH Configuration for EC2/EC3 Deployment
# ============================================
# Path to SSH Private Keys (Use absolute paths on the server!)
# These keys are used to create secure SSH tunnels to Docker daemons
# Generate keys: ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa_ec2
SSH_EC2_KEY=/home/ubuntu/.ssh/id_rsa_ec2
SSH_EC3_KEY=/home/ubuntu/.ssh/id_rsa_ec3
SSH_USERNAME=ubuntu

# ============================================
# Cluster IPs (The actual IP of your servers)
# ============================================
EC1_SERVER_IP=localhost
EC2_SERVER_IP=129.159.249.123
EC3_SERVER_IP=129.154.255.90

# ============================================
# Resource Capacity (GB)
# ============================================
EC2_TOTAL_RAM=12
EC3_TOTAL_RAM=48

# ============================================
# SMTP Config for Alerts (Zoho / Gmail)
# ============================================
# If using Zoho, set host to smtp.zoho.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true

# ============================================
# OAuth Callbacks (Update both here and on GitHub/Google)
# ============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://foodpanda.site/api/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://foodpanda.site/api/auth/google/callback
