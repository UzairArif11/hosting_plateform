# ============================================
# SSH Configuration for EC2/EC3
# ============================================
# Path to SSH Private Keys (Update these paths on the server!)
SSH_EC2_KEY=/home/ubuntu/.ssh/id_rsa
SSH_EC3_KEY=/home/ubuntu/.ssh/id_rsa
SSH_USERNAME=ubuntu

# ============================================
# Database Configuration (Matches docker-compose.yml)
# ============================================
MONGO_URI=mongodb://admin:password123@localhost:27017/vercel_clone?authSource=admin

# ============================================
# Server Configuration
# ============================================
PORT=5000
BASE_DOMAIN=foodpanda.site
NODE_ENV=production
JWT_SECRET=change_this_secret_key_in_production_please

# ============================================
# Resource Limits
# ============================================
EC2_SERVER_IP=129.159.249.123
EC3_SERVER_IP=129.154.255.90
EC2_TOTAL_RAM=12
EC3_TOTAL_RAM=48
