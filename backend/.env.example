# ============================================
# Core Configuration (required)
# ============================================
PORT=5000
NODE_ENV=production
JWT_SECRET=change_this_secret_key_in_production_please
SESSION_SECRET=change_this_session_secret
FRONTEND_URL=https://foodpanda.site

# ============================================
# Database (required)
# ============================================
MONGODB_URI=mongodb://admin:password123@localhost:27017/vercel_clone?authSource=admin

# ============================================
# SSH Username (used for all servers)
# ============================================
SSH_USERNAME=ubuntu

# ============================================
# SSH Key Paths (optional fallback)
# ============================================
# These are FALLBACK paths only. The admin should configure
# SSH keys per-server in the Admin Panel → Servers.
# If the admin sets the sshKeyEnvVar field on a server (e.g. "SSH_EC2_KEY"),
# then the path here will be picked up automatically.
# SSH_EC2_KEY=/home/ubuntu/.ssh/id_rsa_ec2
# SSH_EC3_KEY=/home/ubuntu/.ssh/id_rsa_ec3

# ============================================
# Server IPs / Resources — NOT NEEDED
# ============================================
# All server configuration (IPs, domains, CPU, RAM, containers)
# is now managed 100% from the Admin Panel → Servers page.
# No need to set EC2_SERVER_IP, EC3_SERVER_IP, EC2_TOTAL_RAM, etc.

# ============================================
# SMTP Config for Alerts (Zoho / Gmail)
# ============================================
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true

# ============================================
# OAuth (GitHub / Google login)
# ============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://foodpanda.site/api/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://foodpanda.site/api/auth/google/callback
